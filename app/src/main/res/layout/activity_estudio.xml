<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F8FF"
    tools:context="vista.EstudioActivity">

  <TextView
      android:id="@+id/tvTitulo"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="BrainBoost"
      android:textColor="#1E3A8A"
      android:textSize="36sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@+id/etPregunta"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.4" />


  <EditText
      android:id="@+id/etPregunta"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="32dp"
      android:enabled="false"
      android:gravity="top|start"
      android:hint="Escribe la pregunta"
      android:inputType="textMultiLine"
      android:maxLines="3"
      android:minLines="2"
      android:textColor="#000000"
      android:textSize="24sp"
      app:layout_constraintBottom_toTopOf="@+id/etRespuesta"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

  <EditText
      android:id="@+id/etRespuesta"
      android:layout_width="349dp"
      android:layout_height="266dp"
      android:layout_marginHorizontal="32dp"
      android:enabled="false"
      android:gravity="top|start"
      android:hint="Escribe la respuesta"
      android:inputType="textMultiLine"
      android:maxLines="10"
      android:minLines="4"
      android:textColor="#374151"
      android:textSize="22sp"
      app:layout_constraintBottom_toTopOf="@+id/btnMostrarSolucion"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.516"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etPregunta" />

  <Button
      android:id="@+id/btnIniciarEstudio"
      android:layout_width="300dp"
      android:layout_height="60dp"
      android:backgroundTint="#3B82F6"
      android:text="Iniciar Estudio"
      android:textColor="#FFFFFF"
      app:layout_constraintBottom_toTopOf="@+id/btnIncorrecta"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.495"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etRespuesta"
      app:layout_constraintVertical_bias="0.0" />

  <Button
      android:id="@+id/btnMostrarSolucion"
      android:layout_width="300dp"
      android:layout_height="60dp"
      android:backgroundTint="#3B82F6"
      android:text="Mostrar Solución"
      android:visibility="gone"
      android:textColor="#FFFFFF"
      app:layout_constraintBottom_toTopOf="@+id/btnIncorrecta"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etRespuesta" />

  <Button
      android:id="@+id/btnIncorrecta"
      android:layout_width="160dp"
      android:layout_height="60dp"
      android:text="Incorrecta"
      android:visibility="gone"
      android:backgroundTint="#EF4444"
      android:textColor="#FFFFFF"
      app:layout_constraintTop_toBottomOf="@id/btnMostrarSolucion"
      app:layout_constraintEnd_toStartOf="@id/btnCorrecta"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintBottom_toTopOf="@+id/btnAcabarEstudio" />

  <Button
      android:id="@+id/btnCorrecta"
      android:layout_width="160dp"
      android:layout_height="60dp"
      android:text="Correcta"
      android:visibility="gone"
      android:backgroundTint="#10B981"
      android:textColor="#FFFFFF"
      app:layout_constraintTop_toBottomOf="@id/btnMostrarSolucion"
      app:layout_constraintStart_toEndOf="@id/btnIncorrecta"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintBottom_toTopOf="@+id/btnAcabarEstudio" />

  <Button
      android:id="@+id/btnAcabarEstudio"
      android:layout_width="300dp"
      android:layout_height="60dp"
      android:text="Acabar estudio"
      android:visibility="gone"
      android:backgroundTint="#6366F1"
      android:textColor="#FFFFFF"
      app:layout_constraintTop_toBottomOf="@id/btnIncorrecta"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>